<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="BlueHeighliner.MicroGate.App"
             RequestedThemeVariant="Dark">

    <!-- A VS Code Dark+ inspired palette. Application.Resources is checked before the resources
         FluentTheme itself contributes, so redeclaring its resource keys here with these colors is
         enough to reskin every control that reads them via DynamicResource, including the
         pointerover/pressed/selected states set inside FluentTheme's own control templates, which a
         plain Style selector on Background/Foreground cannot reach. -->
    <Application.Resources>
        <Color x:Key="EditorBackgroundColor">#1E1E1E</Color>
        <Color x:Key="SidebarBackgroundColor">#252526</Color>
        <Color x:Key="StatusBarBackgroundColor">#007ACC</Color>
        <Color x:Key="BorderColor">#3C3C3C</Color>
        <Color x:Key="ForegroundColor">#CCCCCC</Color>
        <Color x:Key="MutedForegroundColor">#9D9D9D</Color>
        <Color x:Key="InputBackgroundColor">#3C3C3C</Color>
        <Color x:Key="InputBackgroundHoverColor">#454545</Color>
        <Color x:Key="AccentColor">#0E639C</Color>
        <Color x:Key="AccentHoverColor">#1177BB</Color>
        <Color x:Key="AccentPressedColor">#0D5789</Color>
        <Color x:Key="ListHoverBackgroundColor">#2A2D2E</Color>
        <Color x:Key="ListSelectedBackgroundColor">#37373D</Color>
        <Color x:Key="ListSelectedAccentBackgroundColor">#094771</Color>

        <SolidColorBrush x:Key="EditorBackgroundBrush" Color="{StaticResource EditorBackgroundColor}" />
        <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{StaticResource SidebarBackgroundColor}" />
        <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="{StaticResource StatusBarBackgroundColor}" />
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
        <SolidColorBrush x:Key="ForegroundBrush" Color="{StaticResource ForegroundColor}" />
        <SolidColorBrush x:Key="MutedForegroundBrush" Color="{StaticResource MutedForegroundColor}" />
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />

        <!-- Button -->
        <SolidColorBrush x:Key="ButtonBackground" Color="{StaticResource InputBackgroundColor}" />
        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{StaticResource InputBackgroundHoverColor}" />
        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{StaticResource InputBackgroundHoverColor}" />
        <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="{StaticResource EditorBackgroundColor}" />
        <SolidColorBrush x:Key="ButtonForeground" Color="{StaticResource ForegroundColor}" />
        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{StaticResource ForegroundColor}" />
        <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{StaticResource ForegroundColor}" />
        <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="{StaticResource MutedForegroundColor}" />
        <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
        <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />

        <!-- Accent button (Classes="accent", the primary action) -->
        <SolidColorBrush x:Key="AccentButtonBackground" Color="{StaticResource AccentColor}" />
        <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="{StaticResource AccentHoverColor}" />
        <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="{StaticResource AccentPressedColor}" />
        <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="{StaticResource InputBackgroundColor}" />
        <SolidColorBrush x:Key="AccentButtonForeground" Color="White" />
        <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="White" />
        <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="White" />
        <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="{StaticResource MutedForegroundColor}" />
        <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="Transparent" />
        <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="Transparent" />
        <SolidColorBrush x:Key="AccentButtonBorderBrushDisabled" Color="Transparent" />

        <!-- ComboBox -->
        <SolidColorBrush x:Key="ComboBoxBackground" Color="{StaticResource InputBackgroundColor}" />
        <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="{StaticResource InputBackgroundHoverColor}" />
        <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="{StaticResource InputBackgroundHoverColor}" />
        <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="{StaticResource EditorBackgroundColor}" />
        <SolidColorBrush x:Key="ComboBoxForeground" Color="{StaticResource ForegroundColor}" />
        <SolidColorBrush x:Key="ComboBoxForegroundDisabled" Color="{StaticResource MutedForegroundColor}" />
        <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="{StaticResource BorderColor}" />
        <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="{StaticResource AccentColor}" />
        <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="{StaticResource AccentColor}" />
        <SolidColorBrush x:Key="ComboBoxBorderBrushDisabled" Color="{StaticResource BorderColor}" />
        <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="{StaticResource SidebarBackgroundColor}" />
        <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="{StaticResource BorderColor}" />
        <SolidColorBrush x:Key="ComboBoxDropDownGlyphForeground" Color="{StaticResource MutedForegroundColor}" />
        <SolidColorBrush x:Key="ComboBoxDropDownGlyphForegroundDisabled" Color="{StaticResource MutedForegroundColor}" />
        <SolidColorBrush x:Key="ComboBoxPlaceHolderForeground" Color="{StaticResource MutedForegroundColor}" />

        <!-- TextBox -->
        <SolidColorBrush x:Key="TextControlBackground" Color="{StaticResource InputBackgroundColor}" />
        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="{StaticResource InputBackgroundHoverColor}" />
        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="{StaticResource InputBackgroundColor}" />
        <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="{StaticResource EditorBackgroundColor}" />
        <SolidColorBrush x:Key="TextControlBorderBrush" Color="{StaticResource BorderColor}" />
        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="{StaticResource AccentColor}" />
        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{StaticResource AccentColor}" />
        <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="{StaticResource BorderColor}" />
        <SolidColorBrush x:Key="TextControlForeground" Color="{StaticResource ForegroundColor}" />
        <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="{StaticResource MutedForegroundColor}" />
        <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="{StaticResource MutedForegroundColor}" />

        <!-- ListBox / ListBoxItem (the frame log) -->
        <SolidColorBrush x:Key="SystemControlBackgroundChromeMediumLowBrush" Color="{StaticResource EditorBackgroundColor}" />
        <SolidColorBrush x:Key="SystemControlForegroundBaseHighBrush" Color="{StaticResource ForegroundColor}" />
        <SolidColorBrush x:Key="SystemControlHighlightAltBaseHighBrush" Color="{StaticResource ForegroundColor}" />
        <SolidColorBrush x:Key="SystemControlHighlightListLowBrush" Color="{StaticResource ListHoverBackgroundColor}" />
        <SolidColorBrush x:Key="SystemControlHighlightListMediumBrush" Color="{StaticResource ListHoverBackgroundColor}" />
        <SolidColorBrush x:Key="SystemControlHighlightListAccentLowBrush" Color="{StaticResource ListSelectedBackgroundColor}" />
        <SolidColorBrush x:Key="SystemControlHighlightListAccentMediumBrush" Color="{StaticResource ListSelectedAccentBackgroundColor}" />
        <SolidColorBrush x:Key="SystemControlHighlightListAccentHighBrush" Color="{StaticResource ListSelectedAccentBackgroundColor}" />
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
        </Style>

        <Style Selector="TextBlock.section-header">
            <Setter Property="Foreground" Value="{StaticResource MutedForegroundBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LetterSpacing" Value="0.6" />
        </Style>

        <Style Selector="TextBlock.field-label">
            <Setter Property="Foreground" Value="{StaticResource MutedForegroundBrush}" />
            <Setter Property="FontSize" Value="11" />
        </Style>
    </Application.Styles>
</Application>
